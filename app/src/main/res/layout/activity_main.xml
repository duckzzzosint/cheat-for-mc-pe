<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp"
    android:background="#0d0d0d">

    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="MC CHEAT" android:textSize="26sp"
        android:textColor="#e0e0e0" android:textStyle="bold"
        android:letterSpacing="0.2" android:layout_marginBottom="4dp"/>

    <TextView android:id="@+id/tv_status"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="● idle" android:textSize="13sp"
        android:textColor="#888888" android:layout_marginBottom="20dp"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="TARGET PID (blank = auto-detect)"
        android:textSize="11sp" android:textColor="#666666" android:layout_marginBottom="4dp"/>

    <EditText android:id="@+id/et_pid"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="auto" android:inputType="number"
        android:textColor="#e0e0e0" android:textColorHint="#444444"
        android:background="@drawable/bg_edittext"
        android:padding="12dp" android:layout_marginBottom="12dp"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="PAYLOAD PATH"
        android:textSize="11sp" android:textColor="#666666" android:layout_marginBottom="4dp"/>

    <EditText android:id="@+id/et_lib_path"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="/data/local/tmp/libcheat.so"
        android:inputType="textUri"
        android:textColor="#e0e0e0" android:textColorHint="#444444"
        android:background="@drawable/bg_edittext"
        android:padding="12dp" android:layout_marginBottom="20dp"/>

    <Button android:id="@+id/btn_extract"
        android:layout_width="match_parent" android:layout_height="48dp"
        android:text="1. EXTRACT ASSETS" android:textColor="#0d0d0d"
        android:backgroundTint="#c8ff00" android:layout_marginBottom="8dp"/>

    <Button android:id="@+id/btn_launch"
        android:layout_width="match_parent" android:layout_height="48dp"
        android:text="2. LAUNCH MINECRAFT" android:textColor="#c8ff00"
        android:backgroundTint="#1a1a1a" android:layout_marginBottom="8dp"/>

    <Button android:id="@+id/btn_inject"
        android:layout_width="match_parent" android:layout_height="48dp"
        android:text="3. INJECT" android:textColor="#ffffff"
        android:backgroundTint="#2a2a2a" android:layout_marginBottom="16dp"/>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:background="#0a0a0a">
        <TextView android:id="@+id/tv_log"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="monospace" android:textSize="11sp"
            android:textColor="#44cc44" android:padding="8dp"/>
    </ScrollView>

</LinearLayout>
